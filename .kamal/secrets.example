# Copy to .kamal/secrets (gitignored). Never commit real values.
# A GitHub token with write:packages, e.g. from `gh auth token`.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
# The ledger signer's hex key. It must stay the same across deploys.
LEDGER_PRIVATE_KEY=

# Staked matches. Read from .env.local at deploy time so there is one copy.
# Leave WALLET_MODE empty (or "play") to keep play money only.
WALLET_MODE=$(grep -E '^WALLET_MODE=' .env.local | cut -d= -f2-)
VERIFY_ET_KEY=$(grep -E '^VERIFY_ET_KEY=' .env.local | cut -d= -f2-)
DEPOSIT_TELEBIRR=$(grep -E '^DEPOSIT_TELEBIRR=' .env.local | cut -d= -f2-)
DEPOSIT_CBE=$(grep -E '^DEPOSIT_CBE=' .env.local | cut -d= -f2-)
TELEGRAM_BOT_TOKEN=$(grep -E '^TELEGRAM_BOT_TOKEN=' .env.local | cut -d= -f2-)
TELEGRAM_MODERATOR_CHAT=$(grep -E '^TELEGRAM_MODERATOR_CHAT=' .env.local | cut -d= -f2-)

# Neon Postgres (from `neon env pull`, which writes .env.local).
DATABASE_URL=$(grep -E '^DATABASE_URL=' .env.local | cut -d= -f2-)
DATABASE_URL_UNPOOLED=$(grep -E '^DATABASE_URL_UNPOOLED=' .env.local | cut -d= -f2-)
